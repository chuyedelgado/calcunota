# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python (scraping de materias)
scraping_materias/scraping/
scraping_materias/.venv/
.venv/
__pycache__/
*.pyc

# vercel
.vercel

# tooling de agentes / editores
.agents/
.claude/
.windsurf/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Volcados de base de datos: contienen expedientes reales de estudiantes.
# Nunca deben acercarse al repo, aunque se generen a mano en una migración.
*.sql
*.dump
# …salvo las migraciones de Prisma, que SÍ van versionadas: sin ellas el
# `migrate deploy` del build no tendría nada que aplicar.
!prisma/migrations/**/*.sql
